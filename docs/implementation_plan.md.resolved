│   │   ├── deal_handler.py              # /deal
│   │   ├── alert_handler.py             # /alert (đăng ký)
│   │   ├── compare_handler.py           # /compare
│   │   ├── scan_handler.py              # /scan
│   │   └── report_handler.py            # /report
│   └── services/
│       ├── db_service.py                # Query PostgreSQL Gold tables
│       └── gemini_service.py            # Gọi Gemini AI tóm tắt
│
├── dashboard/                            # STREAMLIT DASHBOARD
│   ├── Dockerfile
