│       ├── daily_crawl_dag.py           # 06:00 → Chạy Scrapy
│       ├── daily_etl_dag.py             # 08:00 → Chạy Spark Bronze→Silver→Gold
│       └── weekly_report_dag.py         # Thứ 2 → Generate AI report
│
├── telegram_bot/                         # TELEGRAM BOT (FastAPI)
│   ├── Dockerfile
│   ├── requirements.txt
│   ├── main.py                          # Bot entry point
│   ├── handlers/
